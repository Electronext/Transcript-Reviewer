{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electronext.example/schemas/meeting-manifest.schema.json",
  "title": "aTrain Meeting Manifest",
  "type": "object",
  "required": ["schema", "schema_version", "meeting", "recordings"],
  "properties": {
    "schema": { "const": "atrain-meeting-manifest" },
    "schema_version": { "const": 1 },
    "meeting": {
      "type": "object",
      "required": ["id", "title", "status", "assigned_reviewer_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": ["string", "null"] },
        "status": { "type": "string", "minLength": 1 },
        "assigned_reviewer_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "recordings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "label", "project_id", "source_ref", "audio_ref", "transcript_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "number" },
          "label": { "type": "string", "minLength": 1 },
          "project_id": { "type": ["string", "null"] },
          "source_ref": { "type": ["string", "null"] },
          "audio_ref": { "type": ["string", "null"] },
          "transcript_ref": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "aliases", "roles"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "roles": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "speaker_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recording_id", "speaker_id", "person_id"],
        "properties": {
          "recording_id": { "type": "string", "minLength": 1 },
          "speaker_id": { "type": "string", "minLength": 1 },
          "person_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "default": []
    },
    "context": {
      "type": "object",
      "description": "Meeting-level hints/context. Contents are not evidence that an event occurred.",
      "additionalProperties": true,
      "default": {}
    }
  },
  "additionalProperties": false
}
